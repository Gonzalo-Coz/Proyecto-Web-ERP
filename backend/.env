# Variables de entorno por defecto (valores locales/secretos en .env.local, NO versionado)

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=ChangeMeInEnvLocal_9f3b2a7c1d8e4f60
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/yigm_erp?serverVersion=17&charset=utf8"
###< doctrine/doctrine-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=ChangeMeInEnvLocal
###< lexik/jwt-authentication-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> app/apisperu (Consultas DNI/RUC) ###
# Valores por defecto NO secretos. El TOKEN real va en .env.local (no versionado).
APISPERU_BASE_URL=https://dniruc.apisperu.com/api/v1
APISPERU_TIMEOUT=8
APISPERU_TOKEN=
# Opcional: ruta a un CA bundle (cacert.pem) para verificar TLS si php.ini no
# tiene curl.cainfo configurado (típico en Windows). Vacío = usa php.ini.
APISPERU_CAINFO=
###< app/apisperu ###

###> app/nubefact (Facturación electrónica SUNAT) ###
# Valores por defecto NO secretos. La RUTA y el TOKEN reales van en .env.local
# (no versionado). Se obtienen del panel de NubeFact (ambiente DEMO primero).
NUBEFACT_URL=
NUBEFACT_TOKEN=
NUBEFACT_AMBIENTE=demo
NUBEFACT_TIMEOUT=20
###< app/nubefact ###

###> app/session ###
# Duración de la sesión en segundos (JWT). 14400 = 4 horas.
JWT_TTL=14400
###< app/session ###

###> app/exchange-rate ###
# Tipo de cambio SUNAT para importar facturas de Yamaha en USD.
# Deja el token vacío para ingresar el T.C. manualmente en la importación.
EXCHANGE_RATE_URL=https://api.apis.net.pe
EXCHANGE_RATE_TOKEN=
###< app/exchange-rate ###
